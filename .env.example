# ==============================================================================
# GALAXY PRODUCTION CONFIGURATION (TEMPLATE)
# ==============================================================================

# 0. IMAGE VERSION (pin this — never track :latest in production)
GALAXY_IMAGE_TAG=26.0

# 1. CORE IDENTITY & BRANDING
GALAXY_BRAND=Galaxy Enterprise
GALAXY_DOMAIN=localhost
GALAXY_PORT=8080

# 2. SECURITY & AUTHENTICATION (MUST BE CHANGED!)
GALAXY_ADMIN_USERS=admin@your-org.com
GALAXY_BOOTSTRAP_ADMIN_API_KEY=CHANGEME_SECURE_TOKEN
GALAXY_ID_SECRET=CHANGEME_SECURE_HEX

# 3. SERVICE MANAGEMENT
# proftp disabled by default (passive FTP doesn't work on a bridge network
# without a mapped port range) — use SFTP (port 8022) instead.
NONUSE=proftp

# 4. PERFORMANCE & RESOURCE SCALING
# GUNICORN_WORKERS rule of thumb: 2 * CPUs + 1 (of the CPUs you grant via
# GALAXY_CPU_LIMIT below, not the host's total).
GUNICORN_WORKERS=4
CELERY_WORKERS=2
GALAXY_HANDLER_NUMPROCS=2

# 4b. CONTAINER RESOURCE CEILING
# This single container runs Postgres, nginx, Gunicorn, Celery, RabbitMQ,
# Redis and (optionally) Slurm together — cap it so one runaway job can't
# starve the database. Size to the actual deployment host, not a dev box.
GALAXY_CPU_LIMIT=4
GALAXY_MEM_LIMIT=6g
GALAXY_MEM_RESERVATION=2g
GALAXY_SHM_SIZE=1gb
GALAXY_NOFILE_LIMIT=65536

# 5. NETWORKING & HTTPS
# Default False assumes you terminate TLS at an external reverse proxy
# (recommended) or are only reachable on a trusted internal network. For a
# real public domain, either put a TLS proxy in front, or set
# USE_HTTPS_LETSENCRYPT=True and GALAXY_DOMAIN=your.real.domain.
USE_HTTPS=False
USE_HTTPS_LETSENCRYPT=False
PROXY_PREFIX=

# 6. DOCKER & CLUSTER INTEGRATION
# Left off by default: enabling these grants the container root-equivalent
# host access (docker.sock / --privileged). Use compose.override.yml.example
# instead of flipping these here.
GALAXY_DOCKER_ENABLED=False
GALAXY_DOCKER_VOLUMES=""
DOCKER_PARENT=False
GALAXY_DESTINATIONS_DEFAULT=slurm_cluster

# 7. LOGGING & AUDITING
GALAXY_LOGGING=full

# 8. ADVANCED / DEVELOPMENT MODE
BARE=False
ENABLE_TTS_INSTALL=False
LOAD_GALAXY_CONDITIONAL_DEPENDENCIES=False
LOAD_PYTHON_DEV_DEPENDENCIES=False
# False by default: run schema migrations manually (after a backup) instead
# of automatically on every container restart. See docs/PRODUCTION_SETUP.md.
GALAXY_AUTO_UPDATE_DB=False
GALAXY_EXPORT_MARKER=
